NEXT_PUBLIC_API_URL=http://localhost:4000

# Internal URL the Next server uses to reach the API (rewrites /rb-api/*).
API_INTERNAL_URL=http://127.0.0.1:4000

# Server-side API base (SSR pages); in Docker: http://backend:4000
# API_URL=http://127.0.0.1:4000
# Public site origin used for canonical links / sitemap, e.g. https://cv.example.com
# NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement id (build time). Empty = no analytics scripts and no Google hosts in the CSP.
# GA loads only after the visitor allows Analytics in the cookie banner.
NEXT_PUBLIC_GA_ID=
